@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Purchase Order',
  typeNamePlural: 'Purchase Orders',
  title: { value: 'DocumentNumber' },
  description: { value: 'BusinessPartnerCode' }
}

@UI.presentationVariant: [{
  sortOrder: [{ by: 'DocumentNumber', direction: #DESC }]
}]

annotate view ZMERP_C_PURCHASEORDER with
{
  @UI.facet: [
    {
      id: 'GeneralHeaderSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'General Information',
      targetQualifier: 'GeneralGroup',
      position: 10
    },
    {
      id: 'DeliverySection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Delivery & Supplier Details',
      targetQualifier: 'DeliveryGroup',
      position: 20
    },
    {
      id: 'TotalsSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Totals',
      targetQualifier: 'TotalsGroup',
      position: 30
    },
    {
      id: 'ItemsSection',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Line Items',
      targetElement: '_Items',
      position: 40
    },
    {
      id: 'AdminHeaderSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Administrative Data',
      targetQualifier: 'AdminGroup',
      position: 50,
      hidden: true
    }
  ]

  @UI.hidden: true
  DocumentUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  DocumentNumber;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 15 }]
  @UI.selectionField: [{ position: 20 }]
  Status;

  @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 20 }]
  @UI.selectionField: [{ position: 30 }]
  DocumentDate;

  @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 30 }]
  PostingDate;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 40 }]
  @UI.selectionField: [{ position: 40 }]
  CompanyCode;

  @UI.lineItem: [{ position: 60, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 50 }]
  @UI.selectionField: [{ position: 50 }]
  WarehouseCode;

  @UI.lineItem: [{ position: 70, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 60 }]
  @UI.selectionField: [{ position: 60 }]
  BusinessPartnerCode;

  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 70 }]
  CurrencyCode;

  @UI.lineItem: [{ position: 80, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'TotalsGroup', position: 10 }]
  TotalNetAmount;

  @UI.lineItem: [{ position: 90, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'TotalsGroup', position: 20 }]
  TotalGrossAmount;

  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 80 }]
  ResponsiblePerson;

  @UI.multiLineText: true
  @UI.lineItem: [{ position: 100, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 90 }]
  Remarks;

  @UI.lineItem: [{ position: 75, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'DeliveryGroup', position: 10 }]
  SupplierReference;

  @UI.lineItem: [{ position: 78, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'DeliveryGroup', position: 20 }]
  DeliveryDate;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 30 }]
  LocalLastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 40 }]
  LocalLastChangedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 50 }]
  LastChangedAt;
}